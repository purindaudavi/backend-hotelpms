PORT=3500
FRONTEND_ORIGIN=http://localhost:3000
mongoURI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Development-only inbound OTA simulator. Keep this disabled in production.
OTA_SIMULATOR_ENABLED=true
# Optional. When set, send the same value in the x-ota-api-key request header.
OTA_SIMULATOR_API_KEY=my-local-test-key

# Local test-channel bridge (development only). Use the same key as the separate
# dms-test-channel process, and the ID of a disposable test hotel only.
TEST_CHANNEL_PROPERTY_ID=hotel-3085ce35-58f8-4a91-bfea-3b33589f5048

TEST_CHANNEL_URL=http://127.0.0.1:3601

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Optional recipient for new channel setup requests. Requires the MAIL_* settings above.
CHANNEL_REQUEST_REVIEW_EMAIL=

JWT_SECRET=
JWT_SECRET_REFRESH=
